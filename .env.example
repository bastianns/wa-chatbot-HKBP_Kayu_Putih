# URL Webhook Google Apps Script dari langkah Deploy Web App
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/GANTI_DENGAN_DEPLOYMENT_ID_ANDA/exec

# Nomor HP Admin/Pengurus (Bisa lebih dari 1, pisahkan dengan koma)
# Format: 6281234567890
ADMIN_NUMBERS=6281234567890

# Delay Human-Like Broadcast Anti-Ban (Default: 15.000 ms - 25.000 ms ~ sekitar 20 detik per orang)
MIN_DELAY_MS=15000
MAX_DELAY_MS=25000

# Durasi simulasi "Sedang mengetik..." (Composing) di WhatsApp (dalam milidetik)
PRESENCE_TYPING_MS=3000

# (Opsional) Google Gemini API Key untuk Fitur AI Agent Cerdas (100% Gratis dari aistudio.google.com)
GEMINI_API_KEY=AIzaSy...
